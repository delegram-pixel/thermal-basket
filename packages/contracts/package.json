{
  "name": "@thematic/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "ThematicBasket + BasketFactory contracts, tests and deployment scripts",
  "license": "MIT",
  "exports": {
    "./abis": "./abis/index.ts"
  },
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "lint": "hardhat compile && prettier --check \"contracts/**/*.sol\"",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy/01-deploy-factory.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy/01-deploy-factory.ts --network bscTestnet",
    "seed:local": "hardhat run scripts/deploy/02-seed-market.ts --network localhost",
    "seed:testnet": "hardhat run scripts/deploy/02-seed-market.ts --network bscTestnet",
    "baskets:local": "hardhat run scripts/deploy/03-create-sample-baskets.ts --network localhost",
    "baskets:testnet": "hardhat run scripts/deploy/03-create-sample-baskets.ts --network bscTestnet",
    "verify:testnet": "hardhat run scripts/verify/verify-factory.ts --network bscTestnet",
    "export:abi": "hardhat run scripts/utilities/export-abi.ts",
    "export:abi:check": "ABI_CHECK=1 hardhat run scripts/utilities/export-abi.ts",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-ignition": "0.15.14",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "1.1.0",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.1.1",
    "@nomicfoundation/ignition-core": "0.15.14",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.1",
    "chai": "4.5.0",
    "dotenv": "17.2.3",
    "ethers": "6.15.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "1.0.10",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
