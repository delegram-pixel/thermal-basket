{
  "name": "thematic-baskets",
  "version": "1.0.0",
  "private": true,
  "description": "Thematic baskets of tokenized stocks on BNB Smart Chain",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "yarn workspace @thematic/contracts build && yarn workspace @thematic/web build",
    "compile": "yarn workspace @thematic/contracts compile",
    "test": "yarn workspace @thematic/contracts test",
    "test:contracts": "yarn workspace @thematic/contracts test",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:e2e": "yarn workspace @thematic/web e2e",
    "test:all": "yarn test:contracts && yarn test:web && yarn test:e2e",
    "export:abi": "yarn workspace @thematic/contracts export:abi",
    "check:contracts": "yarn workspace @thematic/contracts export:abi:check && yarn workspace @thematic/contracts test",
    "lint": "yarn workspace @thematic/contracts lint && yarn workspace @thematic/web lint",
    "typecheck": "yarn workspace @thematic/web typecheck",
    "dev": "yarn workspace @thematic/web dev",
    "node:chain": "yarn workspace @thematic/contracts run node",
    "deploy:local": "yarn workspace @thematic/contracts deploy:local",
    "deploy:testnet": "yarn workspace @thematic/contracts deploy:testnet",
    "seed:local": "yarn workspace @thematic/contracts seed:local",
    "seed:testnet": "yarn workspace @thematic/contracts seed:testnet",
    "baskets:local": "yarn workspace @thematic/contracts baskets:local",
    "baskets:testnet": "yarn workspace @thematic/contracts baskets:testnet",
    "verify:testnet": "yarn workspace @thematic/contracts verify:testnet",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,sol}\"",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/contracts/artifacts packages/contracts/cache packages/contracts/typechain-types apps/web/.next"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.1.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
